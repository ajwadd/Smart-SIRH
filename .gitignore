# =========================================================================
# SmartHR Project - .gitignore
# =========================================================================

# ====================
# SECRETS & ENV FILES
# ====================
.env
.env.*
*.env
!.env.example

# ====================
# JAVA / MAVEN
# ====================
**/target/
*.class
*.jar
*.war
*.ear
*.log
*.iml
.idea/
*.iws
*.ipr
.project
.classpath
.settings/
*.factorypath

# ====================
# NODE.JS / NEXT.JS
# ====================
**/node_modules/
**/.next/
**/out/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ====================
# PYTHON
# ====================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
*.env

# ====================
# DATA & SESSION FILES (runtime)
# ====================
**/data/sessions/
**/data/chat_history.json
**/ai_vector_store.json

# ====================
# DOCKER
# ====================
docker-compose.override.yml

# ====================
# OS GENERATED
# ====================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# ====================
# IDE
# ====================
.idea/
.vscode/
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# ====================
# SCRATCH / TEMP FILES
# ====================
scratch/

# ====================
# LOGS
# ====================
*.log
logs/
